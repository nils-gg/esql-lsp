{
  "name": "esql-lsp",
  "version": "0.2.0",
  "description": "ESQL language server for IBM App Connect Enterprise (ACE) / IIB — diagnostics, completion, hover, document symbols, go-to-definition and find-references for Neovim, OpenCode and any LSP client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nils-gg/esql-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/nils-gg/esql-lsp/issues"
  },
  "homepage": "https://github.com/nils-gg/esql-lsp#readme",
  "bin": {
    "esql-lsp": "bin/esql-lsp.js"
  },
  "main": "dist/src/server.js",
  "//": "vendor/ is generated by scripts/prepack-grammar.js: the tree-sitter grammar is a file: dependency that does not exist on npm, so the published tarball has to carry it.",
  "files": [
    "bin",
    "dist/src",
    "vendor",
    "scripts",
    "LICENSE",
    "ATTRIBUTION.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/server.js",
    "grammar:test": "npm --prefix tree-sitter-esql test",
    "smoke:stdio": "node scripts/smoke-stdio.js",
    "verify:package": "node scripts/verify-package.js",
    "probe:corpus": "node scripts/probe/corpus-probe.js",
    "probe:grammar-scan": "node scripts/probe/grammar-scan.js",
    "probe:scope-hover": "node scripts/probe/scope-hover.js",
    "probe:scope-completion": "node scripts/probe/scope-completion.js",
    "probe:line-endings": "node scripts/probe/line-endings.js",
    "probe:cache-latency": "node scripts/probe/cache-latency.js",
    "probe:malformed": "node scripts/probe/malformed-requests.js",
    "probe:bench": "node scripts/probe/large-file-bench.js",
    "prepack": "npm run build && node scripts/prepack-grammar.js",
    "postinstall": "node scripts/build-grammar.js"
  },
  "keywords": [
    "esql",
    "lsp",
    "language-server",
    "ibm",
    "app-connect-enterprise",
    "ace",
    "iib",
    "neovim",
    "opencode"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "tree-sitter-esql": "file:tree-sitter-esql"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0",
    "tree-sitter": "^0.25.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
